# Copy to backend/.env and fill in. backend/.env is gitignored -- never commit it.

# Required. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. Overrides the default in app/agent.py (gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Optional. LangSmith tracing for debugging agent runs.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=blueprint-bi