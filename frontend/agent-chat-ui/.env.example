# Copy to frontend/agent-chat-ui/.env and fill in. .env is gitignored.

# --- Local development ---
# The LangGraph dev server. `langgraph dev` serves on 2024 by default.
NEXT_PUBLIC_API_URL=http://localhost:2024

# Must match a key under "graphs" in backend/langgraph.json.
NEXT_PUBLIC_ASSISTANT_ID=agent


# --- Production ---
# In production, do NOT expose the LangGraph URL or API key to the browser.
# Route through the passthrough at src/app/api/[..._path]/route.ts instead:
# point NEXT_PUBLIC_API_URL at your own /api path and set these server-side
# vars, which are never sent to the client.
#
# NEXT_PUBLIC_API_URL=https://your-app.com/api
# LANGGRAPH_API_URL=https://your-deployment.us.langgraph.app
# LANGSMITH_API_KEY=

# Optional. Auth scheme forwarded by the chat UI.
# NEXT_PUBLIC_AUTH_SCHEME=
